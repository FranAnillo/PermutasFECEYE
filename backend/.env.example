NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FRONTEND_URL=http://localhost:5173
# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# postgres por defecto. memory solo para pruebas/desarrollo: pierde sesiones al reiniciar.
SESSION_STORE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=permutas_FECEYE
DB_USER=
DB_PASS=
# HTTPS directo opcional; para proxy HTTPS configurar TRUST_PROXY según su IP real.
TRUST_PROXY=
SSL_KEY_PATH=
SSL_CERT_PATH=
SSL_PASSPHRASE=
# Carpetas locales: se crean al arrancar.
BUZON=./storage/buzon
ARCHIVADOR=./storage/archivador
PROYECTO_DOCENTE=./storage/proyectos-docentes
PLANTILLAS=./storage/plantillas
PDF_FOLDER=./storage/archivador
# Correo heredado (opcional; completar para enviar documentos por email).
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_USER=
EMAIL_PASS=
# No se necesita token de Telegram ni configuración SAML.
